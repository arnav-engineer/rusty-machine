# --- Rusty Machine CUDA Environment Configuration Template ---
# Copy this file to '.env' and modify if needed.

# Base path of the CUDA Toolkit installation (contains 'include/cuda.h' and 'bin/nvcc')
# - System package installations (Ubuntu/Debian apt): /usr or /usr/lib/cuda
# - NVIDIA official toolkit installations: /usr/local/cuda or /usr/local/cuda-12.x
CUDA_PATH=/usr

# Path to the directory containing CUDA shared libraries (libcuda.so, libcublas.so, etc.)
# - System package installations (Ubuntu/Debian apt): /usr/lib/x86_64-linux-gnu
# - NVIDIA official toolkit installations: /usr/local/cuda/lib64
CUDA_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu

# Dynamic linker path to ensure runtime executables find the CUDA libraries
LD_LIBRARY_PATH="/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH"
